page {
  min-height: 100%;
  background: #07100c;
  color: #edf5ef;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text, button, input { box-sizing: border-box; }
button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(79, 154, 105, .18), transparent 38%),
    #07100c;
}

.eyebrow {
  color: #b9f84f;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.panel {
  background: rgba(17, 31, 24, .94);
  border: 1rpx solid rgba(190, 219, 202, .14);
  border-radius: 32rpx;
}

.primary-button {
  height: 92rpx;
  border-radius: 24rpx;
  background: #b9f84f;
  color: #0a150e;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 92rpx;
}

.ghost-button {
  height: 84rpx;
  border: 1rpx solid rgba(190, 219, 202, .18);
  border-radius: 22rpx;
  background: #102219;
  color: #edf5ef;
  font-size: 27rpx;
  line-height: 84rpx;
}

.muted { color: #91a197; }
