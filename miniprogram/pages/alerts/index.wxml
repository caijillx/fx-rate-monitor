<view class="page">
  <view class="page-heading"><text class="eyebrow">SMART ALERTS</text><view>我的提醒</view><text>到达关键价位时再打扰你</text></view>

  <view class="builder panel">
    <view class="builder-title">新建提醒</view>
    <view class="field">
      <text>币种</text>
      <picker mode="selector" range="{{pairOptions}}" range-key="label" value="{{pairIndex}}" bindchange="changePair">
        <view class="select-value">{{pairOptions[pairIndex].label}} <text>›</text></view>
      </picker>
    </view>
    <view class="field">
      <text>提醒类型</text>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="changeType">
        <view class="select-value">{{typeOptions[typeIndex].label}} <text>›</text></view>
      </picker>
    </view>
    <view class="field" wx:if="{{typeOptions[typeIndex].value === 'target'}}">
      <text>目标汇率</text>
      <input type="digit" value="{{target}}" bindinput="changeTarget" placeholder="例如 9.0000" />
    </view>
    <button class="primary-button" bindtap="addAlert">保存提醒</button>
  </view>

  <view class="list-title"><text>已启用 {{enabledCount}} 条</text><text>{{member.active ? '会员额度 10 条' : '免费额度 1 条'}}</text></view>
  <view class="alert-list">
    <view class="alert-item panel" wx:for="{{alerts}}" wx:key="id">
      <view class="alert-icon">{{item.pair === 'GBP_CNY' ? '£' : '$'}}</view>
      <view class="alert-copy"><text class="strong">{{item.pairText}}</text><text>{{item.typeText}}</text></view>
      <switch checked="{{item.enabled}}" color="#9adf2f" data-id="{{item.id}}" bindchange="toggleAlert" />
    </view>
  </view>

  <view class="tip panel"><text class="strong">微信通知说明</text><text>正式版会在用户授权订阅消息后发送；MVP 当前只保存提醒设置。</text></view>
</view>
