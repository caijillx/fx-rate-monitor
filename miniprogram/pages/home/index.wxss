.hero { display: flex; justify-content: space-between; align-items: flex-start; margin: 12rpx 0 46rpx; }
.hero-title { margin-top: 18rpx; white-space: pre-line; font-size: 68rpx; line-height: 1.02; font-weight: 720; letter-spacing: -5rpx; }
.member-pill { padding: 14rpx 20rpx; color: #91a197; background: #102219; border: 1rpx solid rgba(190,219,202,.14); border-radius: 999rpx; font-size: 22rpx; }
.member-pill.active { color: #b9f84f; }
.rate-list { display: grid; gap: 22rpx; }
.rate-card { padding: 30rpx; }
.card-head, .currency, .rate-line, .section-head, .scan-card { display: flex; align-items: center; }
.card-head, .section-head, .scan-card { justify-content: space-between; }
.currency { gap: 20rpx; }
.flag { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; background: #1a2c22; font-size: 36rpx; }
.pair-name { font-size: 29rpx; font-weight: 700; }
.pair-note { margin-top: 5rpx; color: #91a197; font-size: 21rpx; }
.status { padding: 10rpx 14rpx; border-radius: 12rpx; color: #91a197; background: rgba(145,161,151,.08); font-size: 20rpx; font-weight: 700; }
.status.low { color: #b9f84f; background: rgba(185,248,79,.10); }
.rate-line { align-items: baseline; gap: 14rpx; margin: 38rpx 0 30rpx; }
.rate-value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 84rpx; font-weight: 600; letter-spacing: -6rpx; }
.rate-unit { color: #91a197; font-size: 22rpx; }
.mini-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.mini-stats view { padding-top: 20rpx; border-top: 1rpx solid rgba(190,219,202,.12); }
.mini-stats text { display: block; color: #91a197; font-size: 21rpx; }
.mini-stats .strong { display: block; margin-top: 8rpx; font-family: ui-monospace, monospace; font-size: 25rpx; font-weight: 700; }
.chart-card { margin-top: 22rpx; padding: 30rpx; }
.section-title { margin-top: 10rpx; font-size: 32rpx; font-weight: 700; }
.switcher { display: flex; padding: 5rpx; border: 1rpx solid rgba(190,219,202,.14); border-radius: 16rpx; }
.switcher view { padding: 11rpx 17rpx; color: #91a197; border-radius: 12rpx; font-size: 21rpx; font-weight: 700; }
.switcher .selected { color: #0a150e; background: #b9f84f; }
.rate-chart { width: 100%; height: 330rpx; margin-top: 26rpx; }
.chart-meta { display: flex; justify-content: space-between; color: #91a197; font-size: 20rpx; }
.chart-meta .strong { color: #edf5ef; font-weight: 700; }
.scan-card { margin: 22rpx 0; padding: 28rpx 30rpx; }
.countdown { margin-top: 12rpx; color: #b9f84f; font-family: ui-monospace, monospace; font-size: 44rpx; font-weight: 700; }
.scan-copy { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.scan-copy .strong { font-size: 24rpx; font-weight: 700; }
.scan-copy text { color: #91a197; font-size: 19rpx; }
.source { margin-top: 22rpx; color: #5f7166; text-align: center; font-size: 19rpx; }
