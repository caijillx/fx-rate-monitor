.member-hero { padding: 18rpx 2rpx 36rpx; }
.member-hero view { margin: 20rpx 0 18rpx; white-space: pre-line; font-size: 60rpx; line-height: 1.08; font-weight: 720; letter-spacing: -4rpx; }
.member-hero > text:last-child { color: #91a197; font-size: 23rpx; }
.current { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding: 24rpx; }
.current view { display: flex; flex-direction: column; gap: 6rpx; }
.current text { color: #91a197; font-size: 20rpx; }
.current .strong { color: #b9f84f; font-size: 28rpx; font-weight: 700; }
.plans { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.plan { position: relative; padding: 27rpx 22rpx; }
.plan.selected { border: 2rpx solid #b9f84f; background: rgba(32,55,39,.96); }
.plan > view:first-child { display: flex; flex-direction: column; gap: 8rpx; }
.plan .strong { font-size: 28rpx; font-weight: 700; }
.plan text { color: #91a197; font-size: 19rpx; }
.price { display: flex; align-items: baseline; margin-top: 30rpx; }
.price text { color: #b9f84f; font-size: 24rpx; }
.price .strong { color: #b9f84f; font-size: 48rpx; font-weight: 700; }
.recommend { position: absolute; top: -1rpx; right: 18rpx; padding: 7rpx 12rpx; border-radius: 0 0 11rpx 11rpx; color: #0a150e; background: #b9f84f; font-size: 17rpx; font-weight: 800; }
.benefits { display: grid; gap: 28rpx; margin: 22rpx 0; padding: 30rpx; }
.benefit { display: flex; align-items: flex-start; gap: 19rpx; }
.check { display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border-radius: 50%; color: #0a150e; background: #b9f84f; font-size: 22rpx; font-weight: 900; }
.benefit > view:last-child { display: flex; flex-direction: column; gap: 7rpx; }
.benefit .strong { font-size: 25rpx; font-weight: 700; }
.benefit text { color: #91a197; font-size: 20rpx; }
.payment-note { margin-top: 18rpx; color: #607066; text-align: center; font-size: 19rpx; line-height: 1.6; }
